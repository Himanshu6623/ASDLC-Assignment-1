{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reminder Agent result (FR-002..FR-005, FR-009)",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "title", "datetime", "snooze_minutes", "clarification_question"],
  "properties": {
    "intent": {"enum": ["create", "reschedule", "snooze", "clarify", "refuse"]},
    "title": {"type": ["string", "null"], "maxLength": 100},
    "datetime": {"type": ["string", "null"]},
    "snooze_minutes": {"type": ["integer", "null"], "minimum": 1, "maximum": 1440},
    "clarification_question": {"type": ["string", "null"]}
  }
}
